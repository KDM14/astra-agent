# Core Settings
ASTRA_APP_NAME="Astra Agent"
ASTRA_ENVIRONMENT="development"
ASTRA_LOG_LEVEL="INFO"
ASTRA_WORKSPACE_DIR="./workspace"
ASTRA_DATABASE_URL="sqlite+aiosqlite:///astra_agent.db"

# LLM Provider Configuration
# Choose from: mock, deterministic, openai, anthropic, gemini, ollama
ASTRA_PROVIDER="deterministic"
ASTRA_MODEL_NAME="gpt-4o"

# API Keys (leave blank for offline mock/deterministic execution)
ASTRA_OPENAI_API_KEY=""
ASTRA_ANTHROPIC_API_KEY=""
ASTRA_GEMINI_API_KEY=""
ASTRA_OLLAMA_BASE_URL="http://localhost:11434"

# Security & Governance
ASTRA_ENFORCE_WORKSPACE_JAIL="true"
ASTRA_ENABLE_SECRET_REDACTION="true"
ASTRA_REQUIRE_APPROVAL_FOR_SENSITIVE="true"
ASTRA_API_AUTH_TOKEN=""

# Server Settings
ASTRA_API_HOST="0.0.0.0"
ASTRA_API_PORT=8000
